{
  "id": "diamond",
  "title": "A fans out to B and C; both fan in to D",
  "description": "Ready width 1 then 2 then 1. D must see both B and C files.",
  "prefix": "dia",
  "epic": { "title": "[lab] diamond DAG" },
  "harness": "swarm",
  "run": { "wave_size": 1, "max_waves": 2, "stagger_seconds": 0 },
  "beads": [
    { "key": "a", "title": "write files/a.txt", "files": ["files/a.txt"], "mode": "write", "payload": "A" },
    { "key": "b", "title": "write files/b.txt", "files": ["files/b.txt"], "mode": "write", "payload": "B" },
    { "key": "c", "title": "write files/c.txt", "files": ["files/c.txt"], "mode": "write", "payload": "C" },
    { "key": "d", "title": "merge b/c into files/d.txt", "files": ["files/d.txt"], "mode": "merge", "sources": ["files/b.txt", "files/c.txt"], "payload": "D" }
  ],
  "deps": [["b", "a"], ["c", "a"], ["d", "b"], ["d", "c"]],
  "expect": {
    "ready_width": 1,
    "closed_epic": true,
    "files": {
      "files/d.txt": { "contains": ["B", "C", "D"] }
    }
  }
}
