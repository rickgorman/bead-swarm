{
  "id": "nway-log",
  "title": "Six parallel exclusive appends to files/log.txt",
  "description": "Hot log. Ready width 6, no blocks. AM exclusive + retry is the only mutex. Final file has six lines and no lost updates.",
  "prefix": "log",
  "epic": { "title": "[lab] n-way log append" },
  "harness": "swarm",
  "run": {
    "wave_size": 1,
    "max_waves": 6,
    "stagger_seconds": 0
  },
  "beads": [
    { "key": "l1", "title": "append 1 to files/log.txt", "files": ["files/log.txt"], "mode": "append", "lease": "exclusive", "payload": "L1", "hold_seconds": 0.12 },
    { "key": "l2", "title": "append 2 to files/log.txt", "files": ["files/log.txt"], "mode": "append", "lease": "exclusive", "payload": "L2", "hold_seconds": 0.12 },
    { "key": "l3", "title": "append 3 to files/log.txt", "files": ["files/log.txt"], "mode": "append", "lease": "exclusive", "payload": "L3", "hold_seconds": 0.12 },
    { "key": "l4", "title": "append 4 to files/log.txt", "files": ["files/log.txt"], "mode": "append", "lease": "exclusive", "payload": "L4", "hold_seconds": 0.12 },
    { "key": "l5", "title": "append 5 to files/log.txt", "files": ["files/log.txt"], "mode": "append", "lease": "exclusive", "payload": "L5", "hold_seconds": 0.12 },
    { "key": "l6", "title": "append 6 to files/log.txt", "files": ["files/log.txt"], "mode": "append", "lease": "exclusive", "payload": "L6", "hold_seconds": 0.12 }
  ],
  "expect": {
    "ready_width": 6,
    "closed_epic": true,
    "am_retries_min": 1,
    "files": {
      "files/log.txt": {
        "line_count": 6,
        "contains": ["L1", "L2", "L3", "L4", "L5", "L6"]
      }
    }
  }
}
